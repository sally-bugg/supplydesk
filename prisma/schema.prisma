generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
}

model Material {
  id             String          @id @default(cuid())
  shop           String
  sku            String
  name           String
  unit           String          @default("pcs")
  stock          Float           @default(0)
  reorderPoint   Float           @default(0)
  cost           Float           @default(0)
  supplier       String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  bomLines           BomLine[]
  subAsmLines        SubAsmLine[]
  stockMovements     StockMovement[]
  purchaseOrderLines PurchaseOrderLine[]

  @@unique([shop, sku])
}

model SubAssembly {
  id          String       @id @default(cuid())
  shop        String
  sku         String
  name        String
  unit        String       @default("pcs")
  description String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  components  SubAsmLine[]
  bomLines    BomLine[]

  @@unique([shop, sku])
}

model SubAsmLine {
  id            String      @id @default(cuid())
  qty           Float
  subAssembly   SubAssembly @relation(fields: [subAssemblyId], references: [id], onDelete: Cascade)
  subAssemblyId String
  material      Material    @relation(fields: [materialId], references: [id], onDelete: Cascade)
  materialId    String
  createdAt     DateTime    @default(now())

  @@unique([subAssemblyId, materialId])
}

model Product {
  id        String    @id @default(cuid())
  shop      String
  sku       String
  name      String
  shopifyId String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  bomLines       BomLine[]
  productionRuns ProductionRun[]

  @@unique([shop, shopifyId])
}

model BomLine {
  id            String       @id @default(cuid())
  qty           Float
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId     String
  material      Material?    @relation(fields: [materialId], references: [id], onDelete: Cascade)
  materialId    String?
  subAssembly   SubAssembly? @relation(fields: [subAssemblyId], references: [id], onDelete: Cascade)
  subAssemblyId String?
  createdAt     DateTime     @default(now())
}

model StockMovement {
  id         String   @id @default(cuid())
  shop       String
  materialId String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  type       String
  qty        Float
  reference  String
  note       String?
  createdAt  DateTime @default(now())
}

model ProductionRun {
  id        String   @id @default(cuid())
  shop      String
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  qty       Float
  note      String?
  createdAt DateTime @default(now())
}

model PurchaseOrder {
  id         String              @id @default(cuid())
  shop       String
  supplier   String?
  status     String              @default("draft")
  note       String?
  lines      PurchaseOrderLine[]
  createdAt  DateTime            @default(now())
  receivedAt DateTime?
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  materialId      String
  material        Material      @relation(fields: [materialId], references: [id], onDelete: Cascade)
  qty             Float
  cost            Float         @default(0)
}
